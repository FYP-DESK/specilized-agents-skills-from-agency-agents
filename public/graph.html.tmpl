<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Agent Skill Registry — FYP Desk</title>
<style>
  :root {
    --bg: #0b0f14; --panel: #121923; --line: #1f2a38; --text: #dbe4ee;
    --muted: #8494a7; --accent: #4da3ff; --accent2: #9b8cff;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 14px/1.5 ui-sans-serif, system-ui, sans-serif; }
  header { padding: 20px 24px 8px; }
  h1 { margin: 0 0 4px; font-size: 20px; }
  .sub { color: var(--muted); font-size: 13px; }
  .sub a { color: var(--accent); text-decoration: none; }
  main { max-width: 1200px; margin: 0 auto; padding: 12px 24px 48px; }
  .stats { display: flex; gap: 18px; margin: 14px 0; color: var(--muted); font-size: 13px; }
  .stats b { color: var(--text); }
  #search {
    width: 100%; padding: 12px 14px; font-size: 15px; color: var(--text);
    background: var(--panel); border: 1px solid var(--line); border-radius: 10px; outline: none;
  }
  #search:focus { border-color: var(--accent); }
  .layout { display: grid; grid-template-columns: 260px 1fr; gap: 18px; margin-top: 18px; }
  @media (max-width: 800px) { .layout { grid-template-columns: 1fr; } }
  #cats { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 10px; max-height: 70vh; overflow: auto; }
  .cat { display: flex; justify-content: space-between; padding: 6px 8px; border-radius: 6px; cursor: pointer; color: var(--muted); }
  .cat:hover, .cat.active { background: #182231; color: var(--text); }
  .cat .n { font-size: 12px; color: var(--accent2); }
  #agents { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 10px; align-content: start; }
  .card {
    background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 12px; cursor: pointer;
    transition: border-color .12s;
  }
  .card:hover { border-color: var(--accent); }
  .card h3 { margin: 0 0 4px; font-size: 13.5px; color: var(--accent); word-break: break-all; }
  .card p { margin: 0; font-size: 12.5px; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card .tag { display: inline-block; margin-top: 8px; font-size: 11px; color: var(--accent2); }
  .hidden { display: none; }
  #count { color: var(--muted); font-size: 12.5px; margin: 0 0 10px; }
  /* modal */
  dialog { background: var(--panel); color: var(--text); border: 1px solid var(--line); border-radius: 12px; max-width: 900px; width: 92vw; max-height: 88vh; padding: 0; }
  dialog::backdrop { background: rgba(0,0,0,.6); }
  .mhead { display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; border-bottom: 1px solid var(--line); position: sticky; top: 0; background: var(--panel); }
  .mhead h2 { margin: 0; font-size: 15px; color: var(--accent); word-break: break-all; }
  .mhead button { background: var(--line); color: var(--text); border: 0; border-radius: 8px; padding: 6px 12px; cursor: pointer; }
  .mbody { padding: 16px 18px 22px; overflow: auto; max-height: calc(88vh - 61px); }
  .mbody pre { white-space: pre-wrap; word-break: break-word; font: 12.5px/1.6 ui-monospace, monospace; color: #c6d2e0; margin: 0; }
  .mbody .meta { color: var(--muted); font-size: 12.5px; margin-bottom: 12px; }
  .mbody .nb { margin: 14px 0; }
  .mbody .nb span { display: inline-block; background: #182231; border: 1px solid var(--line); border-radius: 999px; padding: 3px 10px; margin: 3px 4px 0 0; font-size: 12px; color: var(--accent2); cursor: pointer; }
</style>
</head>
<body>
<header>
  <h1>Agent Skill Registry</h1>
  <div class="sub">
    279 specialist agents for LLM-driven work. Search, click, copy.
    Agents fetch the same content via <code>GET /api/agent?q=&lt;keywords&gt;</code> ·
    docs: <a href="https://github.com/FYP-DESK/specilized-agents-skills-from-agency-agents" target="_blank">repo README</a>
  </div>
</header>
<main>
  <input id="search" type="search" placeholder="Search agents… e.g. solidity, nextjs, security audit, proposal, tiktok" autofocus />
  <div class="stats" id="stats"></div>
  <div class="layout">
    <aside id="cats"></aside>
    <section>
      <p id="count"></p>
      <div id="agents"></div>
    </section>
  </div>
</main>

<dialog id="dlg">
  <div class="mhead">
    <h2 id="dtitle"></h2>
    <button onclick="dlg.close()">Close</button>
  </div>
  <div class="mbody">
    <div class="meta" id="dmeta"></div>
    <div class="nb" id="dneighbors"></div>
    <pre id="dpre"></pre>
  </div>
</dialog>

<script type="module">
  const DATA = __DATA__;
  const byName = new Map(DATA.agents.map(a => [a.name, a]));
  const esc = s => s.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

  document.getElementById('stats').innerHTML =
    `<span><b>${DATA.total}</b> agents</span><span><b>${Object.keys(DATA.categories).length}</b> categories</span>
     <span>raw index: <a style="color:var(--accent)" href="/api/agents">/api/agents</a></span>`;

  // sidebar categories
  const catsEl = document.getElementById('cats');
  const cats = Object.entries(DATA.categories).sort((a,b) => b[1].length - a[1].length);
  catsEl.innerHTML = `<div class="cat active" data-cat="">All <span class="n">${DATA.total}</span></div>` +
    cats.map(([c, names]) => `<div class="cat" data-cat="${esc(c)}">${esc(c)} <span class="n">${names.length}</span></div>`).join('');
  let activeCat = '';
  catsEl.onclick = e => {
    const el = e.target.closest('.cat'); if (!el) return;
    activeCat = el.dataset.cat;
    catsEl.querySelectorAll('.cat').forEach(x => x.classList.toggle('active', x === el));
    render();
  };

  const grid = document.getElementById('agents');
  const count = document.getElementById('count');
  function render() {
    const q = document.getElementById('search').value.trim().toLowerCase();
    let list = DATA.agents;
    if (activeCat) list = list.filter(a => a.category === activeCat);
    if (q) list = list.filter(a =>
      a.name.toLowerCase().includes(q) || a.title.toLowerCase().includes(q) ||
      a.description.toLowerCase().includes(q) || a.category.toLowerCase().includes(q));
    count.textContent = `${list.length} agent${list.length === 1 ? '' : 's'}`;
    grid.innerHTML = list.map(a => `
      <div class="card" data-name="${esc(a.name)}">
        <h3>${esc(a.name)}</h3>
        <p>${esc(a.description)}</p>
        <span class="tag">${esc(a.category)}</span>
      </div>`).join('');
  }
  document.getElementById('search').oninput = render;
  render();

  grid.onclick = async e => {
    const card = e.target.closest('.card'); if (!card) return;
    const a = byName.get(card.dataset.name);
    document.getElementById('dtitle').textContent = a.name;
    document.getElementById('dmeta').textContent = `${a.category} · ${a.description}`;
    document.getElementById('dneighbors').innerHTML = '';
    document.getElementById('dpre').textContent = 'loading…';
    dlg.showModal();
    try {
      const res = await fetch(`/api/agent?name=${encodeURIComponent(a.name)}`);
      const json = await res.json();
      const nbs = json.neighbors || [];
      document.getElementById('dneighbors').innerHTML = nbs.length
        ? `<b style="font-size:12px;color:var(--muted)">RELATED:</b><br>` + nbs.map(n => `<span data-n="${esc(n)}">${esc(n)}</span>`).join('')
        : '';
      document.getElementById('dneighbors').onclick = ev => {
        const s = ev.target.closest('span[data-n]'); if (!s) return;
        const b = byName.get(s.dataset.n); if (b) { dlg.close(); document.getElementById('search').value = b.name; render(); }
      };
      document.getElementById('dpre').textContent = json.instructions || JSON.stringify(json, null, 2);
    } catch { document.getElementById('dpre').textContent = 'failed to load agent markdown'; }
  };
</script>
</body>
</html>
